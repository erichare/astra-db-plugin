# Astra DB connection, read by the astra-db MCP server and by your application code.
# Copy to .env (git-ignored), or let `npx -y @erichare/astra-mcp login` write it.

# Application token from the Astra console: Settings → Tokens.
ASTRA_DB_APPLICATION_TOKEN=

# Data API endpoint from the database's Overview page. Optional for the MCP server
# when the token sees exactly one active database.
ASTRA_DB_API_ENDPOINT=

# Optional: keyspace (default_keyspace when unset).
ASTRA_DB_KEYSPACE=

# Optional: which database to use when the token sees several and no endpoint is set.
# ASTRA_DB_NAME=

# Optional: hide the write tools.
# ASTRA_MCP_READ_ONLY=1
