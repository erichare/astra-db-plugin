{
  "name": "@erichare/astra-mcp",
  "version": "1.2.1",
  "description": "Astra DB for AI agents: an MCP server with data tools, guarded writes, vector search, interactive MCP Apps views, and bundled Data API code examples \u2014 plus a one-command installer for Claude Code, Codex, Cursor, VS Code, and more.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:ui": "node scripts/build.mjs --ui-only",
    "pretest": "node scripts/build.mjs --ui-only",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome check --write .",
    "start": "node dist/cli.js",
    "seed": "tsx scripts/seed-demo.ts",
    "prepack": "node scripts/build.mjs"
  },
  "mcpName": "io.github.erichare/astra-mcp",
  "bin": {
    "astra-mcp": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/assets.json",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "astra",
    "astra-db",
    "datastax",
    "vector-database",
    "claude",
    "codex",
    "mcp-apps"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erichare/astra-db-plugin.git",
    "directory": "server"
  },
  "homepage": "https://github.com/erichare/astra-db-plugin#readme",
  "bugs": {
    "url": "https://github.com/erichare/astra-db-plugin/issues"
  },
  "author": "Eric Hare",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@clack/prompts": "^1.8.1",
    "@datastax/astra-db-ts": "^2.3.0",
    "@modelcontextprotocol/client": "^2.1.0",
    "@modelcontextprotocol/ext-apps": "^2.0.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^5.0.1",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "happy-dom": "^20.14.5",
    "jsonc-parser": "^3.3.1",
    "playwright": "^1.56.1",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
